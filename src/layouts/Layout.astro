---
import Navbar from "../components/common/Navbar.astro";
import Footer from "../components/common/footer.astro";
import "../styles/style.css";

interface Props {
  title?: string;
  description?: string;
  heroControlled?: boolean;
}

const {
  title = "Serendipia - Agencia de Marketing Digital Ecuador",
  description =
    "Agencia de marketing digital enfocada en resultados, SEO, publicidad y diseño web.",
  heroControlled = false,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lexend:wght@100..900&family=Poppins:wght@300;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/webp" href="/sources/logo-4.webp" />
    <title>{title}</title>
  </head>
  <body
    class="isolate min-h-screen overflow-x-hidden bg-[#f8f9f7] bg-fixed bg-cover bg-center bg-no-repeat [background-image:radial-gradient(ellipse_35%_30%_at_35%_18%,rgba(224,151,244,0.70)_0%,rgba(234,190,239,0.44)_38%,transparent_75%),radial-gradient(ellipse_45%_40%_at_68%_55%,rgba(177,178,255,0.52)_0%,rgba(205,204,255,0.28)_45%,transparent_78%),radial-gradient(ellipse_34%_34%_at_68%_82%,rgba(81,68,242,0.90)_0%,rgba(105,91,247,0.68)_32%,rgba(151,143,250,0.38)_55%,transparent_78%)] font-sans text-white antialiased"
  >
    <Navbar heroControlled={heroControlled} />
    <main class="bg-transparent">
      <slot />
    </main>
    <Footer />

    <script>
      const initializeScrollBounce = () => {
        const sections = Array.from(
          document.querySelectorAll<HTMLElement>("main section:not([data-hero]), footer[data-main-footer]"),
        );
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        sections.forEach((section) => {
          if (section.dataset.scrollBounceReady === "true") return;
          section.dataset.scrollBounceReady = "true";

          if (!reduceMotion) section.classList.add("scroll-bounce-pending");
        });

        if (reduceMotion || !("IntersectionObserver" in window)) {
          sections.forEach((section) => section.classList.remove("scroll-bounce-pending"));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              const section = entry.target as HTMLElement;
              section.classList.remove("scroll-bounce-pending");
              section.classList.add("scroll-bounce-in");
              observer.unobserve(section);
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
        );

        sections.forEach((section) => observer.observe(section));
      };

      initializeScrollBounce();
      document.addEventListener("astro:page-load", initializeScrollBounce);
    </script>
  </body>
</html>
