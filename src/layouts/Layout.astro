---
import Navbar from "../components/common/Navbar.astro";
import InternalNavbar from "../components/common/InternalNavbar.astro";
import Footer from "../components/common/footer.astro";
import MobileTabMenu from "../components/common/MobileTabMenu.astro";
import "../styles/style.css";

interface Props {
  title?: string;
  description?: string;
  heroControlled?: boolean;
  navigation?: "home" | "internal";
}

const {
  title = "Serendipia - Agencia de Marketing Digital Ecuador",
  description =
    "Agencia de marketing digital enfocada en resultados, SEO, publicidad y diseño web.",
  heroControlled = false,
  navigation = "home",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lexend:wght@100..900&family=Poppins:wght@300;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/webp" href="/sources/logo-4.webp" />
    <title>{title}</title>
  </head>
  <body
    class="isolate min-h-screen overflow-x-hidden bg-white font-sans text-white antialiased"
  >
    {!heroControlled && (navigation === "internal" ? <InternalNavbar /> : <Navbar />)}
    <main class="bg-transparent">
      <slot />
    </main>
    <Footer />
    <MobileTabMenu currentPage={navigation === "internal" ? (Astro.url.pathname.replace(/\/$/, "") === "/publicidad-digital" ? "publicidad-digital" : "internal") : "home"} />

    <script>
      const initializeTitleEntrances = () => {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) return;

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("site-title-visible");
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.2, rootMargin: "0px 0px -20% 0px" });

        document.querySelectorAll<HTMLElement>("main h1#hero-title, main h1#service-page-title, main h2:not([data-no-title-animation]), footer h2:not([data-no-title-animation])").forEach((heading) => {
          if (heading.matches("h2") && heading.closest("[data-hero-glass]")) return;
          if (heading.dataset.lettersReady === "true") return;
          const label = heading.textContent?.replace(/\s+/g, " ").trim();
          if (!label) return;
          heading.dataset.lettersReady = "true";
          heading.setAttribute("aria-label", label);

          const walker = document.createTreeWalker(heading, NodeFilter.SHOW_TEXT);
          const nodes: Text[] = [];
          while (walker.nextNode()) nodes.push(walker.currentNode as Text);
          let index = 0;
          nodes.forEach((node) => {
            if (!node.textContent?.trim()) return;
            const fragment = document.createDocumentFragment();
            node.textContent.split(/(\s+)/).forEach((part) => {
              if (!part) return;
              if (/^\s+$/.test(part)) {
                fragment.append(document.createTextNode(part));
                return;
              }
              const word = document.createElement("span");
              word.className = "site-title-word";
              word.setAttribute("aria-hidden", "true");
              Array.from(part).forEach((letter) => {
                const span = document.createElement("span");
                span.className = "site-title-letter";
                span.style.setProperty("--letter-index", String(index));
                index++;
                span.textContent = letter;
                word.append(span);
              });
              fragment.append(word);
            });
            node.replaceWith(fragment);
          });
          heading.classList.add("site-title-ready");
          if (!heading.closest("[data-hero-glass]")) observer.observe(heading);
        });
      };
      initializeTitleEntrances();
      document.addEventListener("astro:page-load", initializeTitleEntrances);
    </script>

    <script>
      const initializeMobileCarousels = () => {
        const mobile = window.matchMedia("(max-width: 767px)");
        const configs = [
          { container: "[data-services-deck]", cards: "[data-service-card]", label: "servicios" },
          { container: "[data-eu-quality-grid]", cards: "[data-eu-quality-piece]", label: "estándar europeo" },
          { container: "[data-blog-grid]", cards: "[data-blog-piece]", label: "noticias" },
        ];

        configs.forEach(({ container, cards: selector, label }) => {
          document.querySelectorAll<HTMLElement>(container).forEach((deck) => {
            if (deck.dataset.mobileCarouselReady === "true") return;
            deck.dataset.mobileCarouselReady = "true";
            const cards = Array.from(deck.querySelectorAll<HTMLElement>(selector));
            if (!cards.length) return;
            const controls = document.createElement("div");
            controls.className = "mobile-carousel-controls";
            controls.setAttribute("aria-label", `Navegación de ${label}`);
            const previous = document.createElement("button");
            const next = document.createElement("button");
            const status = document.createElement("span");
            previous.type = next.type = "button";
            previous.textContent = "←";
            next.textContent = "→";
            previous.setAttribute("aria-label", `Anterior: ${label}`);
            next.setAttribute("aria-label", `Siguiente: ${label}`);
            status.setAttribute("aria-live", "polite");
            controls.append(previous, status, next);
            deck.after(controls);
            let index = 0;
            let carouselVisible = false;

            const render = () => {
              cards.forEach((card, cardIndex) => {
                const active = cardIndex === index;
                card.classList.toggle("mobile-slide-active", mobile.matches && active);
                card.classList.toggle("mobile-slide-enter", mobile.matches && active && carouselVisible);
                if (mobile.matches) {
                  card.setAttribute("aria-hidden", String(!active));
                  card.inert = !active;
                  if (card.matches("[data-service-card]")) card.tabIndex = active ? 0 : -1;
                } else {
                  card.inert = false;
                  if (card.matches("[data-service-card]")) {
                    const visible = card.dataset.visible === "true";
                    card.setAttribute("aria-hidden", String(!visible));
                    card.tabIndex = visible ? 0 : -1;
                  } else {
                    card.removeAttribute("aria-hidden");
                  }
                }
              });
              status.textContent = `${index + 1} / ${cards.length}`;
            };
            const move = (direction: number) => {
              index = (index + direction + cards.length) % cards.length;
              render();
            };
            previous.addEventListener("click", () => move(-1));
            next.addEventListener("click", () => move(1));
            let startX = 0;
            deck.addEventListener("touchstart", (event) => { startX = event.changedTouches[0].clientX; }, { passive: true });
            deck.addEventListener("touchend", (event) => {
              if (!mobile.matches) return;
              const distance = event.changedTouches[0].clientX - startX;
              if (Math.abs(distance) > 45) move(distance < 0 ? 1 : -1);
            }, { passive: true });
            mobile.addEventListener("change", render);
            render();
            requestAnimationFrame(render);
            if ("IntersectionObserver" in window) {
              const observer = new IntersectionObserver((entries) => {
                if (!entries.some((entry) => entry.isIntersecting)) return;
                carouselVisible = true;
                render();
                observer.disconnect();
              }, { threshold: 0.15 });
              observer.observe(deck);
            } else {
              carouselVisible = true;
            }
          });
        });
      };
      initializeMobileCarousels();
      document.addEventListener("astro:page-load", initializeMobileCarousels);
    </script>
  </body>
</html>
