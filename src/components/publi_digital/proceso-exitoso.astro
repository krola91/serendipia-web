---
const steps = [
  { number: "01", title: "Auditamos tus canales digitales", tape: "/sources/process-tape-1.png" },
  { number: "02", title: "Desarrollamos una propuesta personalizada", tape: "/sources/process-tape-2.png" },
  { number: "03", title: "Implementamos las campañas publicitarias", tape: "/sources/process-tape-3.png" },
  { number: "04", title: "Analizamos y optimizamos", tape: "/sources/process-tape-4.png" },
];
---

<section class="process-section" aria-labelledby="process-title">
  <div class="process-section__inner">
    <h2 id="process-title">¿Por qué nuestro proceso es tan <span class="home-highlight">exitoso</span>?</h2>
    <ol class="process-section__grid" role="list">
      {steps.map((step, index) => (
        <li class:list={["process-note", `process-note--${index + 1}`]}>
          <img class="process-note__tape" src={step.tape} alt="" aria-hidden="true" width="416" height="592" loading="lazy" decoding="async" />
          <div class="process-note__paper">
            <span class="process-note__number">{step.number}</span>
            <h3>{step.title}</h3>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style is:inline>
  .process-section { overflow: hidden; padding: clamp(4.5rem, 8vw, 7.5rem) clamp(1.25rem, 4vw, 4rem) clamp(5rem, 8vw, 7.5rem); background: #fff; color: #111827; }
  .process-section__inner { max-width: 1400px; margin-inline: auto; }
  .process-section h2 { max-width: 900px; margin: 0 auto; text-align: center; font-size: clamp(2rem, 3.6vw, 3.4rem); font-weight: 650; line-height: 1.15; letter-spacing: -0.04em; }
  .process-section__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); align-items: center; gap: clamp(1.5rem, 3vw, 3.5rem); margin: clamp(6.5rem, 10vw, 9rem) 0 0; padding: 0; list-style: none; }
  .process-note { position: relative; min-width: 0; padding: 18px; border-radius: 30px; background: #fff; box-shadow: 0 18px 36px rgb(38 45 61 / 15%), 0 4px 12px rgb(38 45 61 / 8%); }
  .process-note--1 { transform: rotate(8deg); }
  .process-note--2 { transform: translateY(8px) rotate(-6deg); }
  .process-note--3 { transform: rotate(7deg); }
  .process-note--4 { transform: translateY(4px) rotate(-8deg); }
  .process-note__tape { position: absolute; z-index: 1; top: -82px; left: 50%; width: 85px; height: auto; transform: translateX(-50%) rotate(-16deg); pointer-events: none; }
  .process-note__paper { display: flex; min-height: 210px; flex-direction: column; justify-content: center; gap: 1rem; padding: clamp(1.25rem, 2vw, 2rem); border-radius: 20px; }
  .process-note--1 .process-note__paper { background: linear-gradient(145deg, #fff0ed, #f9d2d1); color: #a94d3d; }
  .process-note--2 .process-note__paper { background: linear-gradient(145deg, #effbf0, #cfefd4); color: #257b43; }
  .process-note--3 .process-note__paper { background: linear-gradient(145deg, #fff9de, #ffeba3); color: #937100; }
  .process-note--4 .process-note__paper { background: linear-gradient(145deg, #e8fafa, #bee9e9); color: #087c80; }
  .process-note__number { font-size: clamp(2.4rem, 3.8vw, 3.6rem); font-weight: 600; line-height: 1; letter-spacing: -0.04em; }
  .process-note h3 { margin: 0; color: #1f2937; font-size: clamp(0.95rem, 1.25vw, 1.2rem); font-weight: 600; line-height: 1.45; }
  @media (max-width: 900px) {
    .process-section__grid { max-width: 720px; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6rem 3rem; margin-inline: auto; }
  }
  @media (max-width: 520px) {
    .process-section__grid { max-width: 320px; grid-template-columns: 1fr; gap: 5.5rem; margin-top: 6rem; }
    .process-note { padding: 16px; }
    .process-note--1, .process-note--3 { transform: rotate(4deg); }
    .process-note--2, .process-note--4 { transform: rotate(-4deg); }
    .process-note__paper { min-height: 185px; }
  }
</style>
