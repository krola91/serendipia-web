---
const services = [
  {
    title: "ESTUDIO DE MERCADO",
    description:
      "Analizamos y definimos una estrategia alineada con la de tu empresa, priorizando la obtención de resultados",
    points: ["Auditoría online", "ADN de marca", "Identificación de oportunidades", "Estudio de la competencia"],
    tone: "pink",
    icon: '<circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m15.5 15.5 5 5M10.5 7.5v6M7.5 10.5h6"></path>',
  },
  {
    title: "POSICIONAMIENTO SEO",
    description:
      "Hacemos del SEO tu aliado para posicionarte como líder en Google, en las primeras posiciones.",
    points: ["Estudio de palabras clave", "Optimización de contenidos", "SEO On-page, Off-page y más", "Reporting y actualización estratégica"],
    tone: "violet",
    icon: '<path d="m3 10.5 14-5v13l-14-5v-3Z"></path><path d="m7 15 1.5 5h3L10 16M17 9c2 1.2 2 4.8 0 6"></path>',
  },
  {
    title: "DISEÑO WEB",
    description:
      "Creamos sitios web que trascienden y convierten a tus visitantes en clientes.",
    points: ["Análisis inicial", "Contenidos de la página web", "Optimización SEO incluido", "Diseño web personalizado"],
    tone: "lime",
    icon: '<path d="M4 20V11M10 20V7M16 20v-5M22 20V4"></path><path d="m4 8 6-5 6 7 6-8"></path>',
  },
  {
    title: "TIENDA EN LÍNEA",
    description:
      "Desarrollamos tu eCommerce para que comiences a vender tu producto o servicio por internet",
    points: ["Automatización de Ecommerce", "Usabilidad con orientación al cliente", "Integración de botones de pago", "Optimización SEO incluido"],
    tone: "aqua",
    icon: '<rect x="3" y="4" width="18" height="15" rx="2"></rect><path d="M3 8h18M7 6h.01M10 6h.01M8 22h8"></path>',
  },
  {
    title: "PUBLICIDAD DIGITAL",
    description:
      "Hacemos crecer tu negocio con un enfoque dirigido a llegar a tu cliente ideal a través de pauta efectiva",
    points: ["Segmentación objetiva", "Remarketing avanzado", "Campañas multiplataforma", "Reportes mensuales"],
    tone: "silver",
    icon: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"></path><circle cx="18" cy="7" r="3"></circle>',
  },
  {
    title: "MARKETING DE CONTENIDO",
    description:
      "Desarrollamos estrategias para convertir tus redes en un motor de ventas",
    points: ["Creación de contenido", "Distribución del contenido", "Optimización y promoción del contenido", "Monitoreo"],
    tone: "neon",
    icon: '<path d="m12 2 9 5-9 5-9-5 9-5Z"></path><path d="m3 12 9 5 9-5M3 17l9 5 9-5"></path>',
  },
];
---

<section
  class="services-section relative my-6 overflow-hidden bg-transparent py-12 md:my-8"
  aria-labelledby="services-title"
  data-services-section
>
  <div class="relative z-10">
    <div class="mb-5 flex justify-center">
      <div
        class="inline-flex items-center gap-2 rounded-full border border-[#C4C4C4] bg-white px-4 py-2 font-sans text-xs font-medium tracking-[0.01em] text-[#111827] shadow-[0_8px_30px_rgba(107,114,128,0.28)] max-sm:px-3 max-sm:py-1.5 max-sm:text-[0.68rem]"
      >
        <span
          class="size-2 shrink-0 animate-pulse rounded-full bg-[#b87cbd]"
          aria-hidden="true"
        ></span>
        <span>SOLUCIONES DE MARKETING DIGITAL</span>
      </div>
    </div>

    <h2
      id="services-title"
      class="text-center font-sans text-[clamp(2rem,3.2vw,2.75rem)] leading-[1.08] font-bold tracking-[-0.035em] text-[#111827] max-sm:text-[1.875rem]"
    >
      Servicios diseñados para generar resultados
    </h2>

    <div
      class="services-deck-viewport mt-8 overflow-x-auto overflow-y-hidden pb-8 md:mt-10"
      aria-label="Carrusel de servicios"
    >
      <div class="services-deck" data-services-deck>
        {
          services.map((service, index) => (
            <article
              class:list={["service-card", { "is-active": index === 2 }]}
              data-service-card
              data-slot={index < 5 ? String(index) : "hidden"}
              data-visible={index < 5 ? "true" : "false"}
              data-tone={service.tone}
              tabindex="0"
              aria-label={service.title}
            >
              <div class="service-card__visual">
                <div class="service-card__texture" aria-hidden="true"></div>

                <svg
                  class="service-card__icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.65"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={service.icon}
                />

                <p class="service-card__eyebrow">{service.title}</p>
                <div class="service-card__description">
                  <p>{service.description}</p>
                  <ul>
                    {service.points.map((point) => <li>{point}</li>)}
                  </ul>
                </div>
              </div>

              <div class="service-card__footer">
                <h3>{service.title}</h3>
                <button
                  type="button"
                  class="service-card__next"
                  data-services-next
                  aria-label="Mostrar el siguiente servicio"
                  aria-hidden={index === 4 ? "false" : "true"}
                  tabindex={index === 4 ? 0 : -1}
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m9 18 6-6-6-6"></path>
                  </svg>
                </button>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const initializeServices = () => {
    document.querySelectorAll<HTMLElement>("[data-services-section]").forEach((section) => {
      if (section.dataset.ready === "true") return;
      section.dataset.ready = "true";

      const deck = section.querySelector<HTMLElement>("[data-services-deck]");
      const cards = Array.from(
        section.querySelectorAll<HTMLElement>("[data-service-card]"),
      );
      const nextButtons = Array.from(
        section.querySelectorAll<HTMLButtonElement>("[data-services-next]"),
      );
      let startIndex = 0;

      const initializeCardEntrance = () => {
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const entranceCards = cards.filter((card) => card.dataset.visible === "true");

        if (reduceMotion || !("IntersectionObserver" in window)) return;

        entranceCards.forEach((card, index) => {
          card.classList.add("service-card-drop-pending");
          card.style.setProperty("--service-drop-delay", `${index * 160}ms`);
        });

        const entranceObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entranceCards.forEach((card) => {
                card.classList.remove("service-card-drop-pending");
                card.classList.add("service-card-drop-in");
              });
              entranceObserver.disconnect();
            });
          },
          { threshold: 0.18, rootMargin: "0px 0px -8% 0px" },
        );

        entranceObserver.observe(section);
      };

      const activateCard = (activeCard: HTMLElement) => {
        cards.forEach((card) => card.classList.toggle("is-active", card === activeCard));
      };

      const renderWindow = () => {
        cards.forEach((card, index) => {
          const slot = index - startIndex;
          const isVisible = slot >= 0 && slot < 5;
          card.dataset.slot = isVisible ? String(slot) : "hidden";
          card.dataset.visible = String(isVisible);
          card.setAttribute("aria-hidden", String(!isVisible));
          card.tabIndex = isVisible ? 0 : -1;

          const nextButton = card.querySelector<HTMLButtonElement>("[data-services-next]");
          const isCurrentNext = isVisible && slot === 4;
          if (nextButton) {
            nextButton.tabIndex = isCurrentNext ? 0 : -1;
            nextButton.setAttribute("aria-hidden", String(!isCurrentNext));
          }
        });

        nextButtons.forEach((button) => {
          button.setAttribute(
            "aria-label",
            startIndex === 0 ? "Mostrar el siguiente servicio" : "Volver a los servicios anteriores",
          );
        });

        activateCard(cards[startIndex + 2]);
        deck?.setAttribute("data-window", String(startIndex));
      };

      cards.forEach((card) => {
        card.addEventListener("mouseenter", () => activateCard(card));
        card.addEventListener("focusin", () => activateCard(card));
      });

      nextButtons.forEach((button) => {
        button.addEventListener("click", (event) => {
          event.stopPropagation();
          startIndex = startIndex === 0 ? 1 : 0;
          renderWindow();
        });
      });

      renderWindow();
      initializeCardEntrance();
    });
  };

  initializeServices();
  document.addEventListener("astro:page-load", initializeServices);
</script>
