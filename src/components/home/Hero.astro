---
import Navbar from "../common/Navbar.astro";
---

<div
  class="hero-scroll-track relative"
  style="--hero-scroll-height: 300svh; --hero-content-hold: 100svh"
  data-hero-scroll
  data-content-visible="false"
>
<section
  class="sticky top-0 z-0 flex h-svh w-full items-center overflow-hidden"
  aria-labelledby="hero-title"
  data-hero
>
  <Navbar heroControlled />

  <div class="absolute inset-0 z-0" data-hero-background>
    <video
      class="relative z-0 h-full w-full object-cover object-center"
      src="/sources/chess-scroll-hd.mp4"
      muted
      playsinline
      preload="auto"
      aria-hidden="true"
      data-hero-video
      data-scroll-video
    ></video>
    <div class="hero-overlay pointer-events-none absolute inset-0" aria-hidden="true"></div>
  </div>

  <div
    class="hero-glass absolute inset-y-0 left-0 z-10 flex w-1/2 items-center px-[5%] pt-20 max-md:w-[70%] max-md:px-[8%] max-md:pt-[70px] max-sm:w-[85%] max-sm:px-[6%] max-sm:pt-[65px]"
    data-hero-glass
    aria-hidden="true"
    inert
  >
    <div class="relative z-10 max-w-[520px]">
      <div
        class="animate-text-reveal mb-[36px] inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 font-display text-xs font-medium tracking-[0.01em] text-[#111827] [animation-delay:450ms] max-sm:px-3 max-sm:py-1.5 max-sm:text-[0.65rem]"
      >
        <span
          class="size-2 shrink-0 animate-pulse rounded-full bg-[#b87cbd]"
          aria-hidden="true"
        ></span>
        <span>METODOLOGÍA EUROPEA · RESULTADOS GARANTIZADOS</span>
      </div>
      <h1
        id="hero-title"
        class="animate-text-reveal mb-8 text-[clamp(2.5rem,4.5vw,3.5rem)] leading-[1.08] font-bold tracking-[-0.025em] max-md:text-[clamp(2rem,6vw,2.75rem)] max-sm:text-[1.95rem]"
      >
        Agencia de Marketing Digital y SEO:
      </h1>
      <h2
        class="animate-text-reveal mb-10 text-[clamp(1.4rem,2.4vw,1.8rem)] leading-[1.2] font-normal tracking-[-0.015em] text-white/95 [animation-delay:750ms] max-md:text-[clamp(1.25rem,4.5vw,1.6rem)] max-sm:text-xl"
      >
        <span class="bg-[#d2ef28] px-1 font-medium text-[#111827]">Escalamos las ventas</span> de tu empresa
      </h2>
      <p
        class="animate-text-reveal max-w-[440px] font-display text-[clamp(0.95rem,1.35vw,1.1rem)] leading-[1.65] font-light text-white/90 [animation-delay:900ms] [text-shadow:0_1px_10px_rgba(0,0,0,0.3)] max-md:text-[0.95rem] max-sm:text-sm"
      >
        Diseñamos estrategias 360° de posicionamiento, pauta y Growth Hacking para
        multiplicar tus leads y ROI.
      </p>

      <a
        href="#contacto"
        class="hero-button animate-button-in mt-10 inline-flex items-center gap-3 rounded-[8px] border-0 bg-[#b87cbd] px-9 py-4 font-sans font-semibold tracking-[0.02em] text-white shadow-[0_12px_35px_rgba(184,124,189,0.28)] transition-[transform,box-shadow] duration-300 hover:-translate-y-0.5 hover:shadow-[0_16px_40px_rgba(184,124,189,0.36)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white active:translate-y-0 max-sm:px-7 max-sm:py-3.5 max-sm:text-[0.95rem]"
      >
        <span class="relative z-10">IMPULSA TU NEGOCIO HOY</span>
        <svg
          class="relative z-10 h-[18px] w-[18px] transition-transform duration-300 group-hover:translate-x-1"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M12 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>

    <div
      class="hero-glow hero-glow-cyan pointer-events-none absolute top-[15%] -right-20 z-0 size-[250px] rounded-full bg-cyan-300/25 blur-[80px] max-md:size-[150px] max-md:blur-[50px]"
      aria-hidden="true"
      data-hero-glow
    ></div>
    <div
      class="hero-glow hero-glow-magenta pointer-events-none absolute right-[-60px] bottom-[15%] z-0 size-[220px] rounded-full bg-fuchsia-500/20 blur-[80px] max-md:size-[150px] max-md:blur-[50px]"
      aria-hidden="true"
      data-hero-glow
    ></div>
  </div>

  <div
    class="hero-scroll-hint pointer-events-none absolute bottom-8 left-1/2 z-20 flex -translate-x-1/2 items-center gap-2 rounded-full border border-white/80 px-3 py-2 text-[0.625rem] font-medium tracking-[0.16em] text-white max-sm:bottom-6 max-sm:text-[0.55rem]"
    data-hero-scroll-hint
    aria-hidden="true"
  >
    <span class="flex h-5 w-3.5 items-start justify-center rounded-full border border-white pt-1">
      <span class="hero-scroll-hint__dot block size-1 rounded-full bg-white"></span>
    </span>
    <span>DESLIZA PARA EXPLORAR</span>
    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </div>

  <div
    class="animate-socials-in absolute right-10 bottom-10 z-20 flex items-center gap-3 max-md:right-7 max-md:bottom-7 max-md:gap-2.5 max-sm:right-6 max-sm:bottom-6 max-sm:gap-2"
    aria-label="Redes sociales"
    aria-hidden="true"
    data-hero-socials
    inert
  >
    <a
      href="https://tiktok.com/@serendipia"
      target="_blank"
      rel="noopener noreferrer"
      class="social-button social-button--tiktok"
      aria-label="TikTok"
    >
      <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"></path>
      </svg>
    </a>

    <a
      href="https://linkedin.com/company/serendipia"
      target="_blank"
      rel="noopener noreferrer"
      class="social-button social-button--linkedin"
      aria-label="LinkedIn"
    >
      <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
      </svg>
    </a>

    <a
      href="https://instagram.com/serendipia"
      target="_blank"
      rel="noopener noreferrer"
      class="social-button social-button--instagram"
      aria-label="Instagram"
    >
      <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"></path>
      </svg>
    </a>

    <a
      href="https://facebook.com/serendipia"
      target="_blank"
      rel="noopener noreferrer"
      class="social-button social-button--facebook"
      aria-label="Facebook"
    >
      <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path>
      </svg>
    </a>
  </div>
</section>
<div class="pointer-events-none absolute invisible" style="height: var(--hero-content-hold)" data-hero-content-hold aria-hidden="true"></div>
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);
  const instances = new Map<HTMLElement, () => void>();

  const initializeHero = () => {
    document.querySelectorAll<HTMLElement>("[data-hero-scroll]").forEach((track) => {
      if (instances.has(track)) return;
      const hero = track.querySelector<HTMLElement>("[data-hero]");
      const video = track.querySelector<HTMLVideoElement>("[data-scroll-video]");
      if (!hero || !video) return;
      const glass = hero.querySelector<HTMLElement>("[data-hero-glass]");
      const socials = hero.querySelector<HTMLElement>("[data-hero-socials]");
      const glows = hero.querySelectorAll<HTMLElement>("[data-hero-glow]");
      const navbar = document.querySelector<HTMLElement>("[data-navbar]");
      const navbarMenu = navbar?.querySelector<HTMLElement>("[data-menu-wrapper]");
      const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const events = new AbortController();
      const signal = events.signal;
      const playhead = { time: 0 };
      let animation: gsap.core.Tween | undefined;
      let trigger: ScrollTrigger | undefined;
      let refreshFrame = 0;
      let destroyed = false;
      let unlocked = false;

      const pause = () => video.pause();
      video.addEventListener("play", pause, { signal });
      pause();

      const setContentVisible = (visible: boolean) => {
        track.dataset.contentVisible = String(visible);
        if (navbar) navbar.dataset.heroContentVisible = String(visible);
        if (glass) {
          glass.inert = !visible;
          glass.setAttribute("aria-hidden", String(!visible));
        }
        if (socials) {
          socials.inert = !visible;
          socials.setAttribute("aria-hidden", String(!visible));
        }
        if (navbarMenu) {
          navbarMenu.inert = !visible;
          navbarMenu.setAttribute("aria-hidden", String(!visible));
        }
      };

      const updateContent = () => {
        const lastFrame = Math.max(0, video.duration - 0.01);
        const finished = Number.isFinite(lastFrame)
          && playhead.time >= lastFrame - 0.001
          && !video.seeking
          && video.currentTime >= lastFrame - 0.02;
        setContentVisible(motion.matches || finished);
      };

      const seek = () => {
        if (destroyed || video.readyState < 1 || !Number.isFinite(video.duration)) return;
        const time = Math.min(Math.max(0, playhead.time), Math.max(0, video.duration - 0.01));
        // Coalesce seeks while decoding: seeked applies the latest scroll position.
        if (!video.seeking && Math.abs(video.currentTime - time) > 1 / 240) {
          video.currentTime = time;
        }
        // Reveal only after the final requested frame has actually decoded.
        updateContent();
      };
      video.addEventListener("seeked", seek, { signal });

      const refresh = () => {
        cancelAnimationFrame(refreshFrame);
        refreshFrame = requestAnimationFrame(() => {
          if (!destroyed && trigger) ScrollTrigger.refresh();
        });
      };

      const setupVideo = () => {
        if (destroyed || video.readyState < 1 || !Number.isFinite(video.duration) || video.duration <= 0) return;
        trigger?.kill();
        animation?.kill();
        trigger = undefined;
        animation = undefined;
        pause();
        track.classList.toggle("hero-scroll-static", motion.matches);
        setContentVisible(motion.matches);

        if (motion.matches) {
          playhead.time = 0;
          seek();
          resetParallax();
          return;
        }

        animation = gsap.fromTo(playhead, { time: 0 }, {
          time: Math.max(0, video.duration - 0.01),
          ease: "none",
          onUpdate: seek,
          scrollTrigger: {
            id: "hero-scroll-video",
            trigger: track,
            start: "top top",
            // Reserve the extra scroll distance for the fully revealed column.
            end: () => {
              const hold = track.querySelector<HTMLElement>("[data-hero-content-hold]");
              return `+=${Math.max(1, track.offsetHeight - hero.offsetHeight - (hold?.offsetHeight ?? 0))}`;
            },
            scrub: true,
            invalidateOnRefresh: true,
            onRefresh: seek,
          },
        });
        trigger = animation.scrollTrigger;
        refresh();
      };

      const unlockVideo = () => {
        if (unlocked || motion.matches) return;
        unlocked = true;
        // iOS needs a play/pause within the first user gesture to enable seeking.
        const playback = video.play();
        video.pause();
        playback?.then(() => {
          pause();
          seek();
        }).catch(() => {
          if (!destroyed) pause();
        });
      };
      window.addEventListener("pointerdown", unlockVideo, { signal, passive: true });
      window.addEventListener("touchstart", unlockVideo, { signal, passive: true });
      window.addEventListener("keydown", unlockVideo, { signal });

      const moveParallax = (event: MouseEvent) => {
        if (motion.matches || !window.matchMedia("(pointer: fine)").matches) return;
        const rect = hero.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - 0.5;
        const y = (event.clientY - rect.top) / rect.height - 0.5;

        if (glass) glass.style.transform = `translate(${x * 8}px, ${y * 8}px)`;
        glows.forEach((glow, index) => {
          const factor = (index + 1) * 15;
          glow.style.transform = `translate(${-x * factor}px, ${-y * factor}px)`;
        });
      };
      const resetParallax = () => {
        if (glass) glass.style.transform = "";
        glows.forEach((glow) => (glow.style.transform = ""));
      };
      hero.addEventListener("mousemove", moveParallax, { signal });
      hero.addEventListener("mouseleave", resetParallax, { signal });
      video.addEventListener("loadedmetadata", setupVideo, { signal });
      motion.addEventListener("change", setupVideo, { signal });
      window.addEventListener("resize", refresh, { signal });
      window.addEventListener("orientationchange", refresh, { signal });
      const resizeObserver = new ResizeObserver(refresh);
      resizeObserver.observe(track);
      resizeObserver.observe(hero);
      document.fonts.ready.then(refresh);
      window.addEventListener("load", refresh, { signal, once: true });

      instances.set(track, () => {
        destroyed = true;
        events.abort();
        resizeObserver.disconnect();
        cancelAnimationFrame(refreshFrame);
        trigger?.kill();
        animation?.kill();
        pause();
        resetParallax();
        setContentVisible(motion.matches);
        if (navbar) {
          navbar.removeAttribute("data-hero-content-visible");
        }
        if (navbarMenu) {
          navbarMenu.inert = false;
          navbarMenu.setAttribute("aria-hidden", "false");
        }
      });
      track.classList.toggle("hero-scroll-static", motion.matches);
      setContentVisible(motion.matches);
      if (video.readyState >= 1) setupVideo();
    });
  };

  const destroyHeroes = () => {
    instances.forEach((cleanup) => cleanup());
    instances.clear();
  };

  initializeHero();
  document.addEventListener("astro:page-load", initializeHero);
  document.addEventListener("astro:before-swap", destroyHeroes);
  window.addEventListener("pagehide", destroyHeroes);
  window.addEventListener("pageshow", initializeHero);
</script>
