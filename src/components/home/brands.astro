---
const brands = Array.from({ length: 12 }, (_, index) => ({
  id: index + 1,
  name: `Marca ${index + 1}`,
  src: "/sources/images.png",
}));
---

<section
  class="relative z-[1] h-auto overflow-hidden bg-white pt-10 pb-5"
  aria-label="Marcas que confían en Serendipia"
  data-brands
>
  <svg class="absolute size-0" aria-hidden="true">
    <defs>
      <filter id="brand-gray" color-interpolation-filters="sRGB">
        <feColorMatrix
          type="matrix"
          values="
            0 0 0 0 0.40
            0 0 0 0 0.40
            0 0 0 0 0.40
            -0.3333 -0.3333 -0.3333 1 0
          "
          result="monochrome"
        />
        <feComponentTransfer in="monochrome">
          <feFuncA type="table" tableValues="0 1 1 1 1" />
        </feComponentTransfer>
      </filter>

    </defs>
  </svg>

  <div class="brands-marquee">
    <div class="brands-marquee-track">
      <ul class="brands-marquee-group" role="list">
        {
          brands.map((brand) => (
            <li class="brand-item">
              <div class="brand-tile"><img
                class="brand-logo"
                src={brand.src}
                alt={brand.name}
                width="738"
                height="306"
                decoding="async"
              /></div>
            </li>
          ))
        }
      </ul>

      <ul class="brands-marquee-group" role="list" aria-hidden="true">
        {
          brands.map((brand) => (
            <li class="brand-item">
              <div class="brand-tile"><img
                class="brand-logo"
                src={brand.src}
                alt=""
                width="738"
                height="306"
                decoding="async"
              /></div>
            </li>
          ))
        }
      </ul>
    </div>

  </div>
</section>
