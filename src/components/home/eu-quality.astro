<script>
  const initializeEuQualityEntrance = () => {
    document.querySelectorAll<HTMLElement>("[data-eu-quality-section]").forEach((section) => {
      if (section.dataset.entranceReady === "true") return;
      section.dataset.entranceReady = "true";

      const grid = section.querySelector<HTMLElement>("[data-eu-quality-grid]");
      const pieces = Array.from(
        section.querySelectorAll<HTMLElement>("[data-eu-quality-piece]"),
      );
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!grid || reduceMotion || window.matchMedia("(max-width: 767px)").matches || !("IntersectionObserver" in window)) return;

      pieces.forEach((piece) => piece.classList.add("eu-quality-piece-pending"));

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;

            pieces.forEach((piece) => {
              piece.classList.remove("eu-quality-piece-pending");
              piece.classList.add("eu-quality-piece-in");
            });
            observer.disconnect();
          });
        },
        { threshold: 0.18, rootMargin: "0px 0px -8% 0px" },
      );

      observer.observe(grid);
    });
  };

  initializeEuQualityEntrance();
  document.addEventListener("astro:page-load", initializeEuQualityEntrance);
</script>
