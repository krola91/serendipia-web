<section
  class="overflow-hidden bg-transparent px-5 py-[clamp(48px,6vw,72px)] md:px-10 lg:px-20"
  aria-labelledby="opinions-title"
  data-opinions-section
>
  <div
    class="mx-auto grid max-w-[1440px] items-center gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-12 xl:gap-16"
  >
    <div class="max-w-xl text-[#111827]" data-opinions-column="left">
      <h2
        id="opinions-title"
        class="text-[clamp(2rem,3.2vw,2.75rem)] leading-[1.06] font-semibold tracking-[-0.045em]"
      >
        Último caso de <span class="bg-[#f5b93f] px-1">éxito</span>
      </h2>

      <p class="mt-6 text-[clamp(1rem,1.15vw,1.1rem)] leading-[1.7] font-normal text-[#4B5563]">
        El convenio entre La Universidad Nacional Autónoma de México y el Colegio Cordillera de
        Loja logra que todo hispanohablante pueda acceder al programa de B@UNAM.
      </p>

      <a
        href="https://bachilleratoenlinea.ec/"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-5 inline-block text-base font-bold text-[#111827] underline decoration-[#b87cbd] decoration-2 underline-offset-4 transition-colors hover:text-[#4B5563]"
      >
        Bachillerato en línea
      </a>

      <div class="mt-6">
        <a
          href="https://bachilleratoenlinea.ec/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 rounded-[8px] border border-white bg-[#402776] px-6 py-3.5 text-sm font-semibold tracking-[0.08em] text-white shadow-[0_12px_35px_rgba(64,39,118,0.32)] transition-[transform,box-shadow,background-color] duration-300 hover:-translate-y-0.5 hover:bg-[#51328a] hover:shadow-[0_16px_40px_rgba(64,39,118,0.42)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#111827] active:translate-y-0"
        >
          CONOCE MÁS
          <svg
            class="size-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </div>
    </div>

    <div
      class="relative ml-auto w-full max-w-[720px] lg:pb-20"
      data-opinions-column="right"
    >
      <img
        class="block h-auto w-full rounded-[20px] object-cover shadow-[0_18px_55px_rgba(17,24,39,0.1)]"
        src="/sources/estadisticas.png"
        alt="Dashboard del caso de éxito de Bachillerato en línea"
        width="736"
        height="520"
        loading="lazy"
        decoding="async"
      />

      <div
        class="relative z-10 mx-3 -mt-10 rounded-[18px] bg-white p-5 text-[#111827] shadow-[0_20px_55px_rgba(17,24,39,0.16)] sm:mx-6 lg:absolute lg:bottom-0 lg:-left-10 lg:mx-0 lg:mt-0 lg:w-[min(86%,560px)] lg:p-6"
      >
        <div class="flex items-start gap-4">
          <span
            class="grid size-10 shrink-0 place-items-center rounded-full bg-[#111827] text-white"
            aria-hidden="true"
          >
            <svg
              class="size-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="8" r="4"></circle>
              <path d="M4.5 21a7.5 7.5 0 0 1 15 0"></path>
            </svg>
          </span>

          <div class="min-w-0 flex-1">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="font-bold leading-tight">Fabian Sempértegui</p>
                <p class="mt-1 text-sm font-normal text-[#6B7280]">Gerente General</p>
              </div>

              <div class="flex shrink-0 items-center gap-1 text-sm font-semibold" aria-label="Calificación 5 de 5">
                <svg
                  class="size-4 fill-[#b87cbd] text-[#b87cbd]"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                  aria-hidden="true"
                >
                  <path d="m12 2.5 2.9 5.88 6.49.94-4.7 4.58 1.11 6.47L12 17.32l-5.8 3.05 1.11-6.47-4.7-4.58 6.49-.94L12 2.5Z"></path>
                </svg>
                <span>5/5</span>
              </div>
            </div>
          </div>
        </div>

        <p class="mt-4 text-[0.95rem] leading-[1.65] font-normal text-[#4B5563]">
          De la mano de Serendipia en cinco meses conseguimos alrededor 800 leads, una cifra que no
          esperábamos, y mes a mes siguen aumentando las cifras.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const initializeOpinionsEntrance = () => {
    document.querySelectorAll<HTMLElement>("[data-opinions-section]").forEach((section) => {
      if (section.dataset.entranceReady === "true") return;
      section.dataset.entranceReady = "true";

      const columns = Array.from(
        section.querySelectorAll<HTMLElement>("[data-opinions-column]"),
      );
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (reduceMotion || !("IntersectionObserver" in window)) return;

      columns.forEach((column) => column.classList.add("opinions-column-pending"));

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;

            columns.forEach((column) => {
              column.classList.remove("opinions-column-pending");
              column.classList.add("opinions-column-in");
            });
            observer.disconnect();
          });
        },
        { threshold: 0.2, rootMargin: "0px 0px -8% 0px" },
      );

      observer.observe(section);
    });
  };

  initializeOpinionsEntrance();
  document.addEventListener("astro:page-load", initializeOpinionsEntrance);
</script>
