<section
  class="relative px-5 py-[clamp(72px,8vw,110px)] md:px-10 lg:px-20"
  aria-labelledby="proposal-title"
  data-proposal-section
>
  <div
    class="relative mx-auto min-h-[600px] max-w-[1440px] rounded-[28px] bg-[#402776] px-6 pt-10 pb-[280px] text-white shadow-[0_24px_70px_rgba(64,39,118,0.2)] sm:min-h-[620px] sm:px-9 sm:pt-12 sm:pb-[310px] md:min-h-[340px] md:px-10 md:py-12 md:pr-[42%] lg:px-14 lg:py-14 lg:pr-[40%]"
  >
    <div class="relative z-20 max-w-3xl">
      <h2
        id="proposal-title"
        class="text-[clamp(2rem,3.7vw,3.6rem)] leading-[1.06] font-semibold tracking-[-0.045em]"
      >
        ¿Listo para convertirte en líder de tu industria?
      </h2>

      <p class="mt-6 max-w-2xl text-[clamp(1rem,1.2vw,1.125rem)] leading-[1.7] font-semibold text-white/85">
        Déjanos tus datos, enseguida nos ponemos en contacto contigo. Juntos vamos a descubrir cuál
        es la mejor forma de potenciar tu marca y tus resultados online. ¡Anímate, será interesante!
      </p>

      <a
        href="#contacto"
        class="mt-7 inline-flex items-center gap-3 rounded-[8px] bg-[#f5b93f] px-7 py-4 text-sm font-semibold tracking-[0.07em] text-[#111827] shadow-[0_14px_38px_rgba(245,185,63,0.25)] transition-[transform,box-shadow,background-color] duration-300 hover:-translate-y-0.5 hover:bg-[#ffc958] hover:shadow-[0_18px_44px_rgba(245,185,63,0.35)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white active:translate-y-0"
      >
        DÉJANOS TUS DATOS
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </div>

    <img
      class="pointer-events-none absolute right-1/2 bottom-[-76px] z-10 w-[min(105%,400px)] translate-x-1/2 object-contain drop-shadow-[0_26px_36px_rgba(20,8,50,0.3)] sm:w-[450px] md:right-[-18px] md:bottom-[-90px] md:w-[43%] md:max-w-[440px] md:translate-x-0 lg:right-[1%] lg:w-[42%] lg:max-w-[500px]"
      src="/sources/rocket.png"
      alt="Cohete despegando como símbolo de crecimiento digital"
      width="1072"
      height="1456"
      loading="lazy"
      decoding="async"
      data-proposal-rocket
    />
  </div>
</section>

<script>
  const initializeProposalRocket = () => {
    document.querySelectorAll<HTMLElement>("[data-proposal-section]").forEach((section) => {
      if (section.dataset.rocketReady === "true") return;
      section.dataset.rocketReady = "true";

      const rocket = section.querySelector<HTMLElement>("[data-proposal-rocket]");
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!rocket || reduceMotion || !("IntersectionObserver" in window)) return;

      rocket.classList.add("proposal-rocket-pending");

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;

            rocket.classList.remove("proposal-rocket-pending");
            rocket.classList.add("proposal-rocket-landing");
            observer.disconnect();
          });
        },
        { threshold: 0.2, rootMargin: "0px 0px -8% 0px" },
      );

      observer.observe(section);
    });
  };

  initializeProposalRocket();
  document.addEventListener("astro:page-load", initializeProposalRocket);
</script>
