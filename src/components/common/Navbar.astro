---
import InternalNavbar from "./InternalNavbar.astro";

interface Props { heroControlled?: boolean; }
const { heroControlled = false } = Astro.props;
---

<div
  class="pointer-events-none absolute inset-x-0 top-[15px] z-20 flex w-full items-start justify-between gap-4 px-[5%] py-6 max-md:px-[4%] max-md:py-4"
  data-navbar
  data-hero-content-visible={heroControlled ? "false" : undefined}
>
  <a href="/" class="pointer-events-auto flex items-center transition-opacity duration-300 hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300" aria-label="Serendipia, inicio" data-navbar-logo>
    <img class="block h-11 w-auto max-md:h-9" src="/sources/logo-4.webp" alt="Serendipia" width="148" height="44" />
  </a>
  <div class="pointer-events-auto hidden w-[47%] md:block" data-menu-wrapper aria-hidden={heroControlled ? "true" : undefined} inert={heroControlled}>
    <InternalNavbar hideLogo />
  </div>
</div>
