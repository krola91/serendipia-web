<script>
  const initializeMobileTabs = () => {
    document.querySelectorAll<HTMLElement>("[data-mobile-tabs]").forEach((nav) => {
      if (nav.dataset.ready) return;
      nav.dataset.ready = "true";
      const button = nav.querySelector<HTMLButtonElement>("[data-mobile-solutions]");
      const popup = nav.querySelector<HTMLElement>("#mobile-solutions");
      if (!button || !popup) return;
      const close = () => { popup.hidden = true; button.setAttribute("aria-expanded", "false"); button.classList.remove("is-active"); };
      button.addEventListener("click", () => {
        const open = popup.hidden === true;
        popup.hidden = !open;
        button.setAttribute("aria-expanded", String(open));
        button.classList.toggle("is-active", open);
      });
      nav.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => link.addEventListener("click", () => {
        close();
        if (link.hasAttribute("data-mobile-tab") && !link.hasAttribute("target")) {
          nav.querySelectorAll("[data-mobile-tab]").forEach((tab) => { tab.classList.remove("is-active"); tab.removeAttribute("aria-current"); });
          link.classList.add("is-active");
          link.setAttribute("aria-current", "location");
        }
      }));
      document.addEventListener("click", (event) => { if (event.target instanceof Node && !nav.contains(event.target)) close(); });
      document.addEventListener("keydown", (event) => { if (event.key === "Escape" && !popup.hidden) { close(); button.focus(); } });
      const hero = document.querySelector<HTMLElement>("[data-hero-scroll]");
      if (hero) {
        const sync = () => nav.classList.toggle("is-hero-hidden", hero.dataset.contentVisible !== "true");
        sync();
        new MutationObserver(sync).observe(hero, { attributes: true, attributeFilter: ["data-content-visible"] });
      }
    });
  };
  initializeMobileTabs();
  document.addEventListener("astro:page-load", initializeMobileTabs);
</script>
