---
const importantLinks = [
  { label: "Inicio", href: "/" },
  { label: "Servicios", href: "/#services-title" },
  { label: "Caso de éxito", href: "/#opinions-title" },
  { label: "Preguntas frecuentes", href: "/#faq-title" },
  { label: "Quiénes somos", href: "/#who-we-are-title" },
];
---

<footer
  id="contacto"
  class="relative overflow-hidden bg-[#111827] p-[30px]"
  aria-label="Pie de página principal"
  data-main-footer
>
  <div
    class="relative mx-auto max-w-[1440px] p-5 text-white sm:p-6 lg:p-8"
  >
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-[1.15fr_1fr_1fr_0.85fr] lg:gap-10">
      <div>
        <a
          href="/"
          class="inline-flex rounded-md transition-opacity duration-300 hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#f5b93f]"
          aria-label="Serendipia, inicio"
        >
          <img
            class="h-12 w-auto object-contain sm:h-14"
            src="/sources/logo-4.webp"
            alt="Serendipia"
            width="188"
            height="56"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="mt-4 max-w-xs text-sm leading-[1.7] font-normal text-white/65">
          Estrategia, creatividad y tecnología para escalar el crecimiento de tu empresa.
        </p>
      </div>

      <nav aria-label="Links importantes del pie de página">
        <h2 class="text-sm font-bold tracking-[0.02em] text-[#f5b93f]">Links importantes</h2>
        <ul class="mt-4 space-y-2.5" role="list">
          {
            importantLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm font-normal text-white/80 transition-[color,transform] duration-300 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#f5b93f]"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="text-sm font-bold tracking-[0.02em] text-[#f5b93f]">Contacto</h2>
        <ul class="mt-4 space-y-3 text-sm font-normal text-white/80" role="list">
          <li class="flex items-start gap-3">
            <svg
              class="mt-0.5 size-4 shrink-0 text-[#f5b93f]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path>
              <circle cx="12" cy="10" r="2.5"></circle>
            </svg>
            <span>Guayaquil, Ecuador</span>
          </li>
          <li class="flex items-start gap-3">
            <svg
              class="mt-0.5 size-4 shrink-0 text-[#f5b93f]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"></path>
            </svg>
            <span>Atención en Ecuador y LatAm</span>
          </li>
          <li class="flex items-start gap-3">
            <svg
              class="mt-0.5 size-4 shrink-0 text-[#f5b93f]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="5" width="18" height="16" rx="2"></rect>
              <path d="M16 3v4M8 3v4M3 10h18"></path>
            </svg>
            <span>Sesión estratégica de 30 minutos</span>
          </li>
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-bold tracking-[0.02em] text-[#f5b93f]">Síguenos</h2>
        <div class="mt-4 flex flex-wrap items-center gap-2.5" aria-label="Redes sociales">
          <a
            href="https://tiktok.com/@serendipia"
            target="_blank"
            rel="noopener noreferrer"
            class="social-button social-button--tiktok !size-9"
            aria-label="TikTok"
          >
            <svg class="social-icon !size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"></path>
            </svg>
          </a>

          <a
            href="https://linkedin.com/company/serendipia"
            target="_blank"
            rel="noopener noreferrer"
            class="social-button social-button--linkedin !size-9"
            aria-label="LinkedIn"
          >
            <svg class="social-icon !size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
            </svg>
          </a>

          <a
            href="https://instagram.com/serendipia"
            target="_blank"
            rel="noopener noreferrer"
            class="social-button social-button--instagram !size-9"
            aria-label="Instagram"
          >
            <svg class="social-icon !size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"></path>
            </svg>
          </a>

          <a
            href="https://facebook.com/serendipia"
            target="_blank"
            rel="noopener noreferrer"
            class="social-button social-button--facebook !size-9"
            aria-label="Facebook"
          >
            <svg class="social-icon !size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <p
      class="mt-8 border-t border-white/15 pt-5 text-center text-xs leading-[1.6] font-semibold text-white/65 sm:text-left"
    >
      © 2026 Agencia de Marketing Digital Guayaquil, Ecuador Serendipia. Todos los derechos
      reservados.
    </p>
  </div>
</footer>
